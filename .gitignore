# =====================================================
# .gitignore para proyecto Unity + Python (TFG-NPC)
# =====================================================

# -----------------------------------------------
# UNITY — carpetas generadas automáticamente
# -----------------------------------------------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset Store / Package cache
Assets/AssetStoreTools*
Assets/Plugins/Editor/JetBrains*

# Autocreated metafiles — solo se ignoran los huérfanos
# (los .meta sí se commitean junto a su archivo)
# *.meta  <-- NO ignorar, Unity los necesita

# -----------------------------------------------
# UNITY — archivos de proyecto Visual Studio / Rider
# -----------------------------------------------
.vs/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# -----------------------------------------------
# UNITY — builds y archivos binarios
# -----------------------------------------------
*.apk
*.aar
*.symbols.zip
*.aab
*.unitypackage
*.app
ExportedObj/
crashlytics-build.properties

# -----------------------------------------------
# PYTHON — entorno virtual y caché
# -----------------------------------------------
venv/
.venv/
env/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Jupyter Notebooks — checkpoints
.ipynb_checkpoints/

# Distribución / empaquetado
*.egg-info/
dist/
build/
*.egg
.eggs/

# -----------------------------------------------
# MODELOS Y DATOS ENTRENADOS (opcionales)
# Descomenta si no quieres subir los modelos al repo
# -----------------------------------------------
# Assets/*.onnx
# Assets/*.pt
# Assets/SoccerModel*
# Assets/scaler.json

# CSVs de entrenamiento (pueden ser grandes)
Assets/SoccerData_*.csv

# Logs de entrenamiento
PythonTraining/results.txt
PythonTraining/_out.txt
PythonTraining/_check.py

# -----------------------------------------------
# LOGS de builds propios del proyecto
# -----------------------------------------------
build*.log
build_*.log
build_warnings.log
results.txt

# -----------------------------------------------
# SISTEMA OPERATIVO — Windows
# -----------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# -----------------------------------------------
# EDITORES
# -----------------------------------------------
# Visual Studio Code
.vscode/

# JetBrains Rider
.idea/
*.rider/

# Crashpad
# (Unity crash reports)
sysinfo.txt
